# =============================================================================
# UnifiedDataMCP - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your ACTUAL credentials.
# NEVER commit .env to GitHub — it is already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SQL Server (On-Premises) — REQUIRED for all database tools
# -----------------------------------------------------------------------------
# Your SQL Server hostname or IP address (e.g., sql01.company.com or 10.0.1.50)
SQL_SERVER_HOST=your-sql-server.company.com

# SQL Server port (default is 1433 for Microsoft SQL Server)
SQL_SERVER_PORT=1433

# Database name to connect to (e.g., ProductionDB, AnalyticsDW)
SQL_SERVER_DB=ProductionDB

# SQL Server login username (should be a read-only or limited-privilege account)
SQL_SERVER_USER=sa

# SQL Server login password
SQL_SERVER_PASSWORD=YourStrongPassword

# ODBC Driver name installed in your environment.
# For local Windows: "ODBC Driver 18 for SQL Server"
# For Docker/Linux: "ODBC Driver 18 for SQL Server" (installed in Dockerfile)
DB_DRIVER=ODBC Driver 18 for SQL Server

# -----------------------------------------------------------------------------
# 2. Railway PostgreSQL (Staging Database) — REQUIRED for data pipelines
# -----------------------------------------------------------------------------
# Full PostgreSQL connection string from Railway dashboard.
# Format: postgresql://username:password@host:port/database
# Get this from your Railway project → PostgreSQL service → Connect tab
RAILWAY_DB_URL=postgresql://user:pass@host:5432/dbname

# -----------------------------------------------------------------------------
# 3. SharePoint Online (Microsoft Graph API) — REQUIRED for SharePoint tools
# -----------------------------------------------------------------------------
# Azure AD Tenant ID (a GUID like 12345678-1234-1234-1234-123456789abc)
# Found in Azure Portal → Azure Active Directory → Properties → Tenant ID
SP_TENANT_ID=your-tenant-id

# Azure App Registration Application (client) ID
# Found in Azure Portal → App registrations → Your app → Overview
SP_CLIENT_ID=your-app-client-id

# Azure App Registration Client Secret (create one in Certificates & secrets)
SP_CLIENT_SECRET=your-app-secret

# SharePoint Site ID (Graph API identifier for your site)
# Get via Graph Explorer: https://graph.microsoft.com/v1.0/sites?search="Your Site Name"
SP_SITE_ID=your-site-id

# SharePoint Drive ID (document library identifier within the site)
# Get via Graph Explorer after you have site ID:
# https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SP_DRIVE_ID=your-drive-id

# -----------------------------------------------------------------------------
# 4. Application & Security — REQUIRED
# -----------------------------------------------------------------------------
# API Bearer token used to authenticate REST API requests.
# This is YOUR chosen secret string. Use a strong random value (32+ chars).
# Example: openssl rand -hex 32
API_TOKEN=your-secure-api-token

# Secret key used to sign secure download tokens for CSV file downloads.
# Must be at least 10 characters. Use a different strong random value.
DOWNLOAD_TOKEN_SECRET=your-secret-for-download-tokens-min-10-chars

# -----------------------------------------------------------------------------
# 5. Optional / Defaults
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO

# Directory where temporary CSV files are stored.
# In Docker this should be /app/output_files (matches Dockerfile).
# Locally you can use ./output_files
OUTPUT_DIR=/app/output_files

# Base URL for generating download links.
# For local testing: http://localhost:8000
# For Railway production: https://your-app.up.railway.app
APP_BASE_URL=http://localhost:8000
